generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  GLOBAL_ADMIN
  USER
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
}

enum BoardRole {
  BOARD_ADMIN
  KOOR_DIVISION
  STAFF
}

enum CardStatus {
  TO_DO
  ON_PROGRESS
  ON_QC
  REVISION
  DONE
}

enum CardPriority {
  LOW
  MID
  HIGH
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password_hash String
  name          String
  global_role   GlobalRole     @default(USER)
  token_version Int            @default(1) @map("token_version")
  is_active     Boolean        @default(true) @map("is_active")
  created_at    DateTime       @default(now())

  // New multi-role and multi-division relations
  user_roles      UserRole[]
  user_divisions  UserDivision[]
  audit_logs_acted  RoleAuditLog[] @relation("AuditActor")
  audit_logs_target RoleAuditLog[] @relation("AuditTarget")

  // Existing relations
  boards_created  Board[]          @relation("BoardCreator")
  board_members   BoardMember[]
  card_assignees  CardAssignee[]
  card_revisions  CardRevision[]
  card_activities CardActivity[]

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  code        String     @unique // "SUPER_ADMIN", "BOARD_ADMIN", "KOOR_DIVISION", "STAFF"
  name        String
  description String?    @db.Text
  is_system   Boolean    @default(false) @map("is_system")
  created_at  DateTime   @default(now()) @map("created_at")
  updated_at  DateTime   @updatedAt @map("updated_at")

  user_roles  UserRole[]

  @@map("roles")
}

model UserRole {
  user_id     Int      @map("user_id")
  role_id     Int      @map("role_id")
  assigned_at DateTime @default(now()) @map("assigned_at")
  assigned_by Int?     @map("assigned_by")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

model Division {
  id          Int            @id @default(autoincrement())
  code        String?        @unique // "PR", "EEO", "HRD", "RND", "LNT"
  name        String         @unique
  description String?        @db.Text
  created_at  DateTime       @default(now()) @map("created_at")
  updated_at  DateTime       @default(now()) @updatedAt @map("updated_at")

  user_divisions UserDivision[]
  board_members  BoardMember[]
  cards          Card[]

  @@map("divisions")
}

model UserDivision {
  user_id     Int      @map("user_id")
  division_id Int      @map("division_id")
  assigned_at DateTime @default(now()) @map("assigned_at")
  assigned_by Int?     @map("assigned_by")

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)

  @@id([user_id, division_id])
  @@index([user_id])
  @@index([division_id])
  @@map("user_divisions")
}

model RoleAuditLog {
  id             Int      @id @default(autoincrement())
  actor_id       Int      @map("actor_id")
  target_user_id Int      @map("target_user_id")
  action         String   // "ROLE_ASSIGN", "ROLE_REVOKE", "DIVISION_ASSIGN", "DIVISION_REMOVE"
  detail         String?  @db.Text
  created_at     DateTime @default(now()) @map("created_at")

  actor       User @relation("AuditActor", fields: [actor_id], references: [id], onDelete: Cascade)
  target_user User @relation("AuditTarget", fields: [target_user_id], references: [id], onDelete: Cascade)

  @@index([target_user_id])
  @@index([actor_id])
  @@map("role_audit_logs")
}

model Board {
  id          Int         @id @default(autoincrement())
  title       String
  description String?     @db.Text
  status      BoardStatus @default(ACTIVE)
  created_by  Int
  created_at  DateTime    @default(now())

  creator User @relation("BoardCreator", fields: [created_by], references: [id], onDelete: Cascade)

  board_members BoardMember[]
  cards         Card[]

  @@map("boards")
}

model BoardMember {
  id          Int       @id @default(autoincrement())
  board_id    Int
  user_id     Int
  division_id Int?
  role        BoardRole

  board    Board     @relation(fields: [board_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [division_id], references: [id], onDelete: SetNull)

  @@unique([board_id, user_id])
  @@index([board_id, user_id])
  @@map("board_members")
}

model Card {
  id          Int          @id @default(autoincrement())
  board_id    Int
  division_id Int
  title       String
  description String?      @db.Text
  status      CardStatus   @default(TO_DO)
  priority    CardPriority @default(MID)
  due_date    DateTime?
  position    Int          @default(0)
  created_at  DateTime     @default(now())

  board    Board    @relation(fields: [board_id], references: [id], onDelete: Cascade)
  division Division @relation(fields: [division_id], references: [id], onDelete: Restrict)

  assignees   CardAssignee[]
  attachments CardAttachment[]
  revisions   CardRevision[]
  activities  CardActivity[]

  @@index([board_id, status, position])
  @@index([board_id, division_id])
  @@map("cards")
}

model CardAssignee {
  card_id Int
  user_id Int

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([card_id, user_id])
  @@map("card_assignees")
}

model CardAttachment {
  id         Int      @id @default(autoincrement())
  card_id    Int
  title      String
  url        String
  created_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@map("card_attachments")
}

model CardRevision {
  id         Int      @id @default(autoincrement())
  card_id    Int
  user_id    Int
  note       String   @db.Text
  created_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("card_revisions")
}

model CardActivity {
  id          Int      @id @default(autoincrement())
  card_id     Int
  user_id     Int
  action_type String
  description String   @db.Text
  created_at  DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("card_activities")
}
