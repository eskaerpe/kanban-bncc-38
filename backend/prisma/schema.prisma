generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  GLOBAL_ADMIN
  USER
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
}

enum BoardRole {
  BOARD_ADMIN
  KOOR_DIVISION
  STAFF
}

enum CardStatus {
  TO_DO
  ON_PROGRESS
  ON_QC
  REVISION
  DONE
}

enum CardPriority {
  LOW
  MID
  HIGH
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password_hash String
  name          String
  global_role   GlobalRole     @default(USER)
  created_at    DateTime       @default(now())

  boards_created  Board[]          @relation("BoardCreator")
  board_members   BoardMember[]
  card_assignees  CardAssignee[]
  card_revisions  CardRevision[]
  card_activities CardActivity[]

  @@map("users")
}

model Division {
  id   Int    @id @default(autoincrement())
  name String @unique

  board_members BoardMember[]
  cards         Card[]

  @@map("divisions")
}

model Board {
  id          Int         @id @default(autoincrement())
  title       String
  description String?     @db.Text
  status      BoardStatus @default(ACTIVE)
  created_by  Int
  created_at  DateTime    @default(now())

  creator User @relation("BoardCreator", fields: [created_by], references: [id], onDelete: Cascade)

  board_members BoardMember[]
  cards         Card[]

  @@map("boards")
}

model BoardMember {
  id          Int       @id @default(autoincrement())
  board_id    Int
  user_id     Int
  division_id Int?
  role        BoardRole

  board    Board     @relation(fields: [board_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [division_id], references: [id])

  @@unique([board_id, user_id])
  @@map("board_members")
}

model Card {
  id          Int          @id @default(autoincrement())
  board_id    Int
  division_id Int
  title       String
  description String?      @db.Text
  status      CardStatus   @default(TO_DO)
  priority    CardPriority @default(MID)
  due_date    DateTime?
  position    Int          @default(0)
  created_at  DateTime     @default(now())

  board    Board    @relation(fields: [board_id], references: [id], onDelete: Cascade)
  division Division @relation(fields: [division_id], references: [id])

  assignees   CardAssignee[]
  attachments CardAttachment[]
  revisions   CardRevision[]
  activities  CardActivity[]

  @@map("cards")
}

model CardAssignee {
  card_id Int
  user_id Int

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([card_id, user_id])
  @@map("card_assignees")
}

model CardAttachment {
  id         Int      @id @default(autoincrement())
  card_id    Int
  title      String
  url        String
  created_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@map("card_attachments")
}

model CardRevision {
  id         Int      @id @default(autoincrement())
  card_id    Int
  user_id    Int
  note       String   @db.Text
  created_at DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("card_revisions")
}

model CardActivity {
  id          Int      @id @default(autoincrement())
  card_id     Int
  user_id     Int
  action_type String
  description String   @db.Text
  created_at  DateTime @default(now())

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("card_activities")
}
